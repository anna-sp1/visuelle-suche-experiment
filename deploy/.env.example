# Copy to deploy/.env and fill in. deploy/.env is not committed.

# Name of the server under which JATOS is reached, e.g. studie.example.de.
# It must point at the server (DNS), and ports 80 and 443 must be open for the certificate.
JATOS_DOMAIN=studie.example.de

# Database passwords: long random values, e.g. from `openssl rand -base64 24`.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Port on 127.0.0.1 where JATOS is reachable on the server itself (default 9000).
#JATOS_LOCAL_PORT=9000
