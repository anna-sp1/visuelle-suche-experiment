# Copy to deploy/.env and fill in. deploy/.env is not committed.

# Database passwords: long random values, e.g. from `openssl rand -base64 24`.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Where JATOS listens for the nginx proxy (plain HTTP). Default: 127.0.0.1:9000, for nginx
# on the same machine. For nginx on another machine, the address of this machine's
# interface towards it (README.md: "nginx auf einem anderen Rechner").
#JATOS_BIND=127.0.0.1
#JATOS_PORT=9000

# For deploy/study.sh upload (optional here; the environment works too). JATOS_URL defaults
# to http://localhost:9000, i.e. JATOS on this server. The token: JATOS user menu > API tokens.
#JATOS_URL=http://localhost:9000
#JATOS_TOKEN=
